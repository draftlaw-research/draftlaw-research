---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="wrap">
    <div class="page-title">
      <p class="eyebrow">Error 404</p>
      <h1>We could not find that page</h1>
      <p>The link may be old or mistyped. Try the articles list, or go back to the front page.</p>
    </div>
    <p class="section">
      <a class="btn" href="/">Front page</a>
      <a class="btn ghost" href="/articles/">All articles</a>
    </p>
  </div>
</Base>
