---
import { SITE, NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="wrap masthead">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
 <img class="brand-logo" src="/logo.svg" alt="" height="40" />
      <span class="brand-name">DraftLaw</span>
      <span class="brand-sub">Research</span>
    </a>
    <nav class="nav" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
