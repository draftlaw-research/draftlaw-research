---
import { Image } from 'astro:assets';
import type { Author } from '../lib/content';
import { initials } from '../lib/content';
import { getPhoto } from '../lib/images';

interface Props {
  author: Author;
  big?: boolean;
}
const { author, big = false } = Astro.props;
const photo = getPhoto(author.data.photo);
---

<span class:list={['avatar', big && 'big']} aria-hidden="true">
  {photo ? <Image src={photo} alt="" width={big ? 192 : 112} height={big ? 192 : 112} /> : initials(author.data.name)}
</span>
